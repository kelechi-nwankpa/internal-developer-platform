{
  "name": "${{ values.name }}",
  "version": "0.1.0",
  "description": "${{ values.description }}",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test \"test/**/*.test.ts\"",
    "docker:build": "docker build -t ${{ values.name }}:local .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env ${{ values.name }}:local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@fastify/sensible": "6.0.8",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@types/node": "22.20.5",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
